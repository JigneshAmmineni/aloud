# Production reverse proxy. Domain + email injected from .env via the caddy
# service's environment (see docker-compose.prod.yml). Caddy obtains and
# auto-renews the Let's Encrypt cert for ALOUD_DOMAIN.

{
	email {$ALOUD_EMAIL}
}

{$ALOUD_DOMAIN} {
	# Gate the whole site behind one shared login. Username + bcrypt hash come
	# from .env (ALOUD_AUTH_USER / ALOUD_AUTH_HASH). Remove this block to make
	# the site open again.
	basic_auth {
		{$ALOUD_AUTH_USER} {$ALOUD_AUTH_HASH}
	}

	# signaling + health → backend; everything else → frontend
	@backend path /api/* /start /sessions/* /healthz
	handle @backend {
		reverse_proxy localhost:7860
	}
	handle {
		reverse_proxy localhost:3000
	}
}

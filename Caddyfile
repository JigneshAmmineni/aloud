# Production reverse proxy. Domain + email injected from .env via the caddy
# service's environment (see docker-compose.prod.yml). Caddy obtains and
# auto-renews the Let's Encrypt cert for ALOUD_DOMAIN.

{
	email {$ALOUD_EMAIL}
}

{$ALOUD_DOMAIN} {
	# The site-wide basic_auth gate is gone: real per-user auth (Firebase,
	# REQUIREMENTS §4.8) now gates every API route in the backend itself.

	# FR-51: bound request bodies at the edge — /documents* now routes
	# straight to the backend, and an unbounded authed POST must never
	# get the chance to fill the VM's RAM (the route also caps its read).
	request_body {
		max_size 10MB
	}

	# signaling + documents + health → backend; everything else → frontend
	# (FR-52: prod previously reached the upload endpoint only through
	# Next's rewrite hop — the workspace routes are matched directly)
	@backend path /api/* /start /sessions/* /documents /documents/* /healthz
	handle @backend {
		reverse_proxy localhost:7860
	}
	handle {
		reverse_proxy localhost:3000
	}
}

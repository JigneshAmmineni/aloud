# Required — the backend refuses to boot without these (app/config.py names
# any that are missing). Add the real values to .env (never committed).
DEEPGRAM_API_KEY=
# The LLM key for the configured LLM_PROVIDER (anthropic by default).
# Create one at console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Path to the Firebase service-account JSON (REQUIREMENTS.md §4.8, C-4) —
# used by the backend and scripts/grant_admin.py. The key file itself is
# gitignored; never commit it. Local dev: the key's filename inside backend/
# (the container's working dir). Prod: leave unset — docker-compose.prod.yml
# mounts the key and sets this itself.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional — defaults shown.
# CARTESIA_VOICE_ID defaults to a public Cartesia demo voice if unset.
CARTESIA_VOICE_ID=
STT_PROVIDER=deepgram_flux
TTS_PROVIDER=cartesia

# LLM. LLM_MODEL runs the agent loop; JUDGE_MODEL runs the small yes/no
# check in front of document creation (FR-60). On anthropic the supported
# models are claude-sonnet-5-5 and claude-haiku-5-5 (each needs its own
# request settings — agent/providers.py). LLM_EFFORT (low | medium | high)
# applies to the agent loop only; the judge always runs at low.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-5-5
LLM_EFFORT=medium
# To run on Gemini instead: LLM_PROVIDER=google, LLM_MODEL=gemini-2.5-flash,
# remove JUDGE_MODEL (it then defaults to LLM_MODEL), and set GOOGLE_API_KEY
# (aistudio.google.com); ANTHROPIC_API_KEY is then not required.
# GOOGLE_API_KEY=

# Toggle the LLM→TTS markdown sanitizer (SDD §2.3) to hear output with and
# without it. (The snake_case → spoken-words filter is always on, separately.)
TTS_SANITIZE_ENABLED=true

# Cartesia Sonic-3 speech rate. 1.0 = normal; 0.85 ≈ 15% slower. Tune by ear.
CARTESIA_SPEED=0.85

# Deepgram Flux end-of-turn confidence (0–1). Higher = softer turn-taking (waits
# for more certainty you're done before replying). But too high and Flux may
# never be confident enough, so it keeps listening — 0.9 was perpetual in
# testing. 0.8 is the proven-responsive value; nudge up in small steps if you
# want it softer. Library default is 0.7.
FLUX_EOT_THRESHOLD=0.8

# Log level for the structured JSON logs. The default is INFO (FR-39: logs
# ship to Cloud Logging, and DEBUG includes transcript/LLM text — the safe
# state is the default). Set DEBUG explicitly for local development only.
LOG_LEVEL=INFO

# FR-34 provider rates for the admin cost ESTIMATES (never stored; derived
# at display time). Fill from the provider consoles' current pricing; 0.0
# (the default) means "not configured" and estimates show $0.
# RATE_STT_PER_MINUTE       — Deepgram Flux, $ per streamed audio minute
# RATE_LLM_PER_1M_TOKENS_IN  — LLM_MODEL, $ per 1M input tokens  (Claude Sonnet 5.5: 2)
# RATE_LLM_PER_1M_TOKENS_OUT — LLM_MODEL, $ per 1M output tokens (Claude Sonnet 5.5: 10)
# RATE_TTS_PER_1M_CHARS      — Cartesia, $ per 1M characters
RATE_STT_PER_MINUTE=
RATE_LLM_PER_1M_TOKENS_IN=
RATE_LLM_PER_1M_TOKENS_OUT=
RATE_TTS_PER_1M_CHARS=

# Postgres. docker-compose sets this to the bundled db service; only set it
# here if running the backend outside compose.
# DATABASE_URL=postgresql+asyncpg://aloud:aloud@localhost:5432/aloud

# --- Production deployment only (docker-compose.prod.yml + Caddy) ---
# Ignored by the local dev stack; required when deploying per deployment.md.
# ALOUD_DOMAIN  — the domain Caddy serves + gets the HTTPS cert for.
# ALOUD_EMAIL   — for Let's Encrypt expiry notices.
# POSTGRES_PASSWORD — strong password; prod Postgres + DATABASE_URL use it.
ALOUD_DOMAIN=work-aloud.com
ALOUD_EMAIL=
POSTGRES_PASSWORD=

# (The old Caddy HTTP Basic Auth gate is gone — per-user Firebase auth
# replaced it; ALOUD_AUTH_USER / ALOUD_AUTH_HASH are no longer read.)

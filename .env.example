# Required — the backend refuses to boot without these (app/config.py names
# any that are missing). Add the real values to .env (never committed).
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=

# Optional — defaults shown.
# CARTESIA_VOICE_ID defaults to a public Cartesia demo voice if unset.
CARTESIA_VOICE_ID=
LLM_MODEL=gemini-2.5-flash
STT_PROVIDER=deepgram_flux
LLM_PROVIDER=google
TTS_PROVIDER=cartesia

# Toggle the LLM→TTS markdown sanitizer (SDD §2.3) to hear output with and
# without it.
TTS_SANITIZE_ENABLED=true

# Log level for the structured JSON logs (SDD §4). DEBUG includes transcript
# and LLM text; INFO and above carry only lengths, counts, and timings.
LOG_LEVEL=DEBUG

# Postgres. docker-compose sets this to the bundled db service; only set it
# here if running the backend outside compose.
# DATABASE_URL=postgresql+asyncpg://aloud:aloud@localhost:5432/aloud
